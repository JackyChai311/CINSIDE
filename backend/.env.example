# === Agent 后端选择 ===
# mock | browser_use | hermes | openclaw
AGENT_BACKEND=mock

# === Vision LLM (护照 OCR) ===
# 留空则使用 mock 数据，可立即演示
# 智谱 GLM-4V 示例：
# VISION_API_BASE=https://open.bigmodel.cn/api/paas/v4
# VISION_API_KEY=your_key_here
# VISION_MODEL=glm-4v-plus
VISION_API_BASE=https://open.bigmodel.cn/api/paas/v4
VISION_API_KEY=
VISION_MODEL=glm-4v-plus

# === Browser Use Agent ===
# 留空则 BrowserUseAgent 会报缺依赖
BROWSER_USE_LLM_BASE=https://open.bigmodel.cn/api/paas/v4
BROWSER_USE_LLM_KEY=
BROWSER_USE_LLM_MODEL=glm-4-plus
BROWSER_USE_HEADLESS=false

# === Hermes Agent ===
HERMES_API_BASE=http://localhost:8001

# === OpenClaw Agent ===
OPENCLAW_BIN=openclaw
OPENCLAW_PROFILE=openclaw

# === 文件存储 ===
UPLOAD_DIR=./_uploads

# === 前端地址（CORS）===
FRONTEND_ORIGIN=http://localhost:5173
